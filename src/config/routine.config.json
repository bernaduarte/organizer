  "workouts": {
    "A": [
      { "id": "goblet-squat", "name": "Agachamento goblet", "equipment": "Kettlebell 8kg", "sets": 3, "reps": "12-15" },
      {
        "id": "push-up",
        "name": "Flexão (inclinada ou no chão)",
        "sets": 3,
        "reps": "max",
        "notes": "Mãos um pouco mais abertas que os ombros, cotovelos a ~45° do corpo, corpo reto, descer controlando."
      },
      {
        "id": "barbell-row",
        "name": "Remada curvada com barra",
        "sets": 3,
        "reps": "10-12",
        "notes": "Joelhos levemente dobrados, tronco a ~45°, coluna reta, abdômen contraído, puxar em direção ao umbigo sem dar impulso. Começar só com a barra ou 2kg de cada lado e subir 2kg por vez.",
        "stopIf": "Parar a série se a coluna arredondar ou o tronco subir. Trocar pela remada unilateral apoiada se a lombar cansar antes das costas ou houver dor/fisgada."
      },
      {
        "id": "stiff",
        "name": "Stiff com barra",
        "sets": 3,
        "reps": "10-12",
        "notes": "Joelhos destravados, descer só até onde a coluna fica reta (não precisa encostar no chão), carga moderada.",
        "stopIf": "Parar se a lombar arredondar ou doer. Alternativa: terra romeno ou terra romeno unilateral."
      },
      { "id": "lateral-raise", "name": "Elevação lateral", "equipment": "Halteres 2-3kg", "sets": 3, "reps": "12-15" },
      { "id": "curl", "name": "Rosca com barra", "sets": 2, "reps": "12" },
      { "id": "plank", "name": "Prancha", "sets": 3, "durationSeconds": "30-45" }
    ],
    "B": [
      { "id": "lunge", "name": "Afundo", "equipment": "Halteres 5kg", "sets": 3, "reps": "10", "perSide": true },
      { "id": "floor-press", "name": "Supino no chão", "equipment": "Barra ou halteres", "sets": 3, "reps": "10-12" },
      { "id": "one-arm-row", "name": "Remada unilateral", "equipment": "Kettlebell 8kg", "sets": 3, "reps": "12", "perSide": true },
      { "id": "kb-swing", "name": "Swing com kettlebell", "sets": 3, "reps": "15" },
      { "id": "db-press", "name": "Desenvolvimento em pé", "equipment": "Halteres 5kg", "sets": 3, "reps": "10-12" },
      { "id": "triceps-ext", "name": "Tríceps francês", "sets": 2, "reps": "12" },
      { "id": "dead-bug", "name": "Dead bug", "sets": 3, "reps": "10", "perSide": true }
    ]
